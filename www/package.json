{
  "name": "subconverter-next",
  "version": "0.2.13-beta.dev.36b38f2",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "rebuild:wasm:dev": "cd .. && ./scripts/build-wasm.sh && cd www && pnpm dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "deploy:netlify": "netlify deploy",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json --persist-to .wrangler/state",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@jat/subconverter-wasm": "^0.2.36",
    "@monaco-editor/react": "^4.7.0",
    "@types/js-yaml": "^4.0.9",
    "@vinext/cloudflare": "^1.0.1",
    "autoprefixer": "^10.6.1",
    "js-yaml": "^5.4.2",
    "monaco-editor": "^0.57.0",
    "next": "^16.4.0-canary.57",
    "next-intl": "^4.14.9",
    "postcss": "^8.5.28",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-server-dom-webpack": "^19.3.0",
    "vinext": "^1.0.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.35",
    "eslint": "^10.11.0",
    "eslint-config-next": "^16.3.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "url": "^0.11.4",
    "vite": "^8.3.2",
    "wrangler": "^4.147.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=12.0.0 <13.0.0",
      "onFail": "download"
    }
  },
  "type": "module"
}
