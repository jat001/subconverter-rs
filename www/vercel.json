{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "framework": "vite",
  "installCommand": "bash ../scripts/vercel-install.sh",
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    { "src": "^/404$", "methods": ["GET", "HEAD"], "status": 404 },
    { "src": "^/api/(.*)$", "dest": "/api" }
  ]
}
