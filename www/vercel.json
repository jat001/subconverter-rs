{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "framework": "vite",
  "installCommand": "bash ../scripts/vercel-install.sh",
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
