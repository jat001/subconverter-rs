{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "framework": "vite",
  "installCommand": "bash ../scripts/vercel-install.sh",
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "proxy": {
    "entrypoint": "vercel/index.ts",
    "matcher": "/api/:path*"
  },
  "routes": [
    { "src": "^/404$", "methods": ["GET", "HEAD"], "status": 404 }
  ]
}
