{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",

  "name": "subconverter-rs",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",

  "workers_dev": true,
  "preview_urls": true,

  // Known pages have static directory indexes; missing paths serve 404.html with status 404.
  // Only API requests and explicit 404 URLs run the Worker; ordinary page views stay on the CDN.
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/404", "/404.html", "/404/"],
  },

  "cache": {
    "enabled": true,
  },

  "observability": {
    "issues": {
      "enabled": true,
    },
    "logs": {
      "enabled": true,
    },
    "traces": {
      "enabled": true,
    },
  },

  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "14531ced7508404099ce8b35ba5c3534",
    },
  ],

  "previews": {},
}
