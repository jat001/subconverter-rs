{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",

  "name": "subconverter-rs",
  "compatibility_date": "2026-10-01",

  "main": "worker/index.ts",

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/404", "/404.html", "/404/"],
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
  },

  "cache": {
    "enabled": true,
  },

  "observability": {
    "issues": {
      "enabled": true,
    },
    "logs": {
      "enabled": true,
    },
    "traces": {
      "enabled": true,
    },
  },

  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "14531ced7508404099ce8b35ba5c3534",
    },
  ],

  "previews": {},
}
