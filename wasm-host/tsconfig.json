{
  // Type-checks sources and tests; tsconfig.build.json emits src/ to dist/
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2023"],
    // No "type": "module" in package.json, so src/*.ts compiles to CommonJS (wasm-pack's nodejs
    // target require()s the bindings) while dynamic import() calls are kept as-is
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    // Tests run directly through Node's type stripping, which only supports erasable syntax
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "test"]
}
